<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package Info -->
    <PackageId>cheqi-sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Cheqi</Authors>
    <Company>Cheqi</Company>
    <Description>Official .NET SDK for Cheqi - End-to-end encrypted digital receipt processing</Description>
    <PackageTags>cheqi;receipts;e-receipts;encryption;e2e</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cheqi/cheqi-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" />
  </ItemGroup>

</Project>
